<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>RES Quote Edit</label>
    <description>DIR-763: Grants Quote Create + Edit. Assigned to RM/Specialist only. With Quote Edit removed from the shared profile and per-role permission sets, only RM/Specialist (plus System Admins) can edit Quotes; everyone else is read-only.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <objectPermissions>
        <object>Opportunity</object>
        <allowCreate>false</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>false</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
    <objectPermissions>
        <object>Quote</object>
        <allowCreate>true</allowCreate>
        <allowDelete>false</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <viewAllRecords>false</viewAllRecords>
    </objectPermissions>
</PermissionSet>
