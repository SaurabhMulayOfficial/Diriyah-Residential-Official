<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Redirect To Record</masterLabel>
    <description>Automatically navigates to a record page. Used as the final screen of the Create Payment Plan flow.</description>
    <targets>
        <target>lightning__FlowScreen</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__FlowScreen">
            <property name="recordId" type="String" label="Record Id" description="Id of the record to navigate to." role="inputOnly" />
            <property name="objectApiName" type="String" label="Object API Name" description="Defaults to Product2." role="inputOnly" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>