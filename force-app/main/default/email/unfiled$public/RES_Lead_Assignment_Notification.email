<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>Lead Assignment Notification</title>
</head>

<body style="margin:0;padding:0;background:#f6f3ee;font-family:Arial,Helvetica,sans-serif;">

<table width="100%" cellpadding="0" cellspacing="0" bgcolor="#f6f3ee">
<tr>
<td align="center" style="padding:40px 20px;">

<table width="650" cellpadding="0" cellspacing="0"
       style="background:#ffffff;border-radius:12px;
              overflow:hidden;
              box-shadow:0 8px 24px rgba(0,0,0,0.08);">

    <!-- Header -->
    <tr>
        <td style="background:#e2c58b;
                   padding:30px;
                   text-align:center;">

            <h1 style="margin:0;
                       color:#4A3103;
                       font-size:28px;
                       font-weight:600;">
                New Lead Assigned
            </h1>

            <p style="margin-top:10px;
                      color:#4A3103;
                      font-size:15px;">
                A new customer has been assigned to you.
            </p>

        </td>
    </tr>

    <!-- Body -->
    <tr>
        <td style="padding:35px; color:#444444;">

            <p style="font-size:16px;margin-top:0;">
                Dear <strong>{!Lead.OwnerFullName}</strong>,
            </p>

            <p style="font-size:15px;line-height:1.7;">
                A new lead has been assigned to you. Please review the customer details below and contact them at the earliest opportunity.
            </p>

            <table width="100%" cellpadding="12" cellspacing="0"
                   style="background:#fbf8f2;
                          border:1px solid #eadfc9;
                          border-radius:8px;
                          margin:25px 0;">

                <tr>
                    <td width="35%" style="font-weight:bold;color:#7A5A2A;">
                        Customer Name
                    </td>

                    <td>
                        <a href="{!Lead.Link}"
                           style="color:#9A6A21;
                                  text-decoration:none;
                                  font-weight:bold;">
                            {!Lead.Name}
                        </a>
                    </td>
                </tr>

                <tr>
                    <td style="font-weight:bold;color:#7A5A2A;">
                        Mobile
                    </td>

                    <td>
                        {!Lead.MobilePhone}
                    </td>
                </tr>

                <tr>
                    <td style="font-weight:bold;color:#7A5A2A;">
                        Email
                    </td>

                    <td>
                        {!Lead.Email}
                    </td>
                </tr>

            </table>

            <!-- CTA Button -->
            <table cellpadding="0" cellspacing="0" align="center">
                <tr>
                    <td align="center"
                        bgcolor="#C89B5A"
                        style="border-radius:6px;">

                        <a href="{!Lead.Link}"
                           style="display:inline-block;
                                  padding:15px 34px;
                                  color:#ffffff;
                                  text-decoration:none;
                                  font-size:16px;
                                  font-weight:bold;">
                            View Lead
                        </a>

                    </td>
                </tr>
            </table>

            <p style="margin-top:35px;
                      color:#666;
                      font-size:14px;
                      line-height:1.6;">
                Kindly review the lead details and initiate customer engagement as soon as possible.
            </p>

        </td>
    </tr>

    <!-- Footer -->
    <tr>
        <td style="background:#e2c58b;
                   padding:22px;
                   text-align:center;
                   border-top:1px solid #ece4d5;">

            <p style="margin:0;
                      color:#4A3103;
                      font-size:14px;">
                Thank you,
            </p>

            <p style="margin:8px 0 0;
                      font-weight:bold;
                      color:#4A3103;
                      font-size:15px;">
                Operations Team
            </p>

        </td>
    </tr>

</table>

</td>
</tr>
</table>

</body>
</html>