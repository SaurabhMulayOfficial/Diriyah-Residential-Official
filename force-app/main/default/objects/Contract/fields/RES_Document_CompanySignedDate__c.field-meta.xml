<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Document_CompanySignedDate__c</fullName>
    <description>Company signed date as DD/MM/YYYY.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(CompanySignedDate), &quot;&quot;,
LPAD(TEXT(DAY(CompanySignedDate)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH(CompanySignedDate)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
TEXT(YEAR(CompanySignedDate)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Document Company Signed Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
