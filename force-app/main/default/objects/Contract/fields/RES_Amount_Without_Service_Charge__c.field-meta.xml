<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Amount_Without_Service_Charge__c</fullName>
    <description>Contract value excluding Service Charge: sum of Contract Item Price excluding the Payment Plan, Installment and Service Charge CIP Types. Total Contract Value less the Service Charge lines.</description>
    <label>Amount Without Service Charge</label>
    <summarizedField>ContractItemPrice.Price</summarizedField>
    <summaryFilterItems>
        <field>ContractItemPrice.RES_CIP_Type__c</field>
        <operation>notEqual</operation>
        <value>Payment Plan</value>
    </summaryFilterItems>
    <summaryFilterItems>
        <field>ContractItemPrice.RES_CIP_Type__c</field>
        <operation>notEqual</operation>
        <value>Installment</value>
    </summaryFilterItems>
    <summaryFilterItems>
        <field>ContractItemPrice.RES_CIP_Type__c</field>
        <operation>notEqual</operation>
        <value>Service Charge</value>
    </summaryFilterItems>
    <summaryForeignKey>ContractItemPrice.ContractId</summaryForeignKey>
    <summaryOperation>sum</summaryOperation>
    <trackHistory>false</trackHistory>
    <type>Summary</type>
</CustomField>
