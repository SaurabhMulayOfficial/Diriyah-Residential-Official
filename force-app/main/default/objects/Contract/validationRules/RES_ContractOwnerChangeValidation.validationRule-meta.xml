<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_ContractOwnerChangeValidation</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c),
    RecordType.DeveloperName = &quot;RES_Residential_Sales&quot;,
    ISCHANGED(OwnerId),
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>OwnerId</errorDisplayField>
    <errorMessage>You are not authorized to change the Contract Owner.</errorMessage>
</ValidationRule>
