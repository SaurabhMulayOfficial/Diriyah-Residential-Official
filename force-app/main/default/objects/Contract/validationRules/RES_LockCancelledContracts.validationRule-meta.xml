<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_LockCancelledContracts</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c),
    RecordType.DeveloperName = &quot;RES_Residential_Sales&quot;,
    NOT(ISNEW()),
    ISPICKVAL(PRIORVALUE(Status), &quot;Canceled&quot;)
)</errorConditionFormula>
    <errorMessage>This Contract cannot be edited because it has been cancelled.</errorMessage>
</ValidationRule>
