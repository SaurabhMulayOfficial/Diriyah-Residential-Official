<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Document_Reservation_StartDate__c</fullName>
    <description>Reservation start date as DD/MM/YYYY.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(DATEVALUE(RES_Reservation_Start_Date__c)), &quot;&quot;,
LPAD(TEXT(DAY(DATEVALUE(RES_Reservation_Start_Date__c))), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH(DATEVALUE(RES_Reservation_Start_Date__c))), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
TEXT(YEAR(DATEVALUE(RES_Reservation_Start_Date__c))))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Document Reservation Start Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
