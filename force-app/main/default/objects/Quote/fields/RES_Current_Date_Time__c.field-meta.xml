<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Current_Date_Time__c</fullName>
    <externalId>false</externalId>
    <formula>LPAD(TEXT(MONTH(DATEVALUE(NOW() + 3/24))),2,&quot;0&quot;) &amp; &quot;.&quot; &amp;
LPAD(TEXT(DAY(DATEVALUE(NOW() + 3/24))),2,&quot;0&quot;) &amp; &quot;.&quot; &amp;
RIGHT(TEXT(YEAR(DATEVALUE(NOW() + 3/24))),2) &amp; &quot;-&quot; &amp;
MID(TEXT(NOW() + 3/24),12,8)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Current Date Time</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
