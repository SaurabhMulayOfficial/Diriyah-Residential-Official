<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_LockCancelledQuote</fullName>
    <active>true</active>
    <description>This Quote is Cancelled and locked. You are not allowed to edit it further</description>
    <errorConditionFormula>AND(
    NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c),
    RecordType.DeveloperName = &quot;RES_Residential_Sales&quot;,
    NOT(ISNEW()),
    ISPICKVAL(PRIORVALUE(Status), &quot;Cancelled&quot;),
    NOT(ISCHANGED(IsSyncing))
)</errorConditionFormula>
    <errorMessage>This Quote is Cancelled and locked. You are not allowed to edit it further</errorMessage>
</ValidationRule>
