<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Lock_Converted_Leads</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c),

    OR(
        $RecordType.DeveloperName = &quot;RES_Company&quot;,
        $RecordType.DeveloperName = &quot;RES_Individual&quot;
    ),

    IsConverted,

    NOT(ISCHANGED(IsConverted))
)</errorConditionFormula>
    <errorMessage>Converted leads are read-only and cannot be edited.</errorMessage>
</ValidationRule>
