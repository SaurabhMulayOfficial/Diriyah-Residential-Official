<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Validation_Rule_on_Unit_Preference</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c),
    OR(
        $RecordType.DeveloperName = &quot;RES_Company&quot;,
        $RecordType.DeveloperName = &quot;RES_Individual&quot;
    ),
        ISPICKVAL(RES_Lead_Sub_Status__c, &quot;251&quot;)
    ,
    ISBLANK(RES_Unit_Preference__c)
)</errorConditionFormula>
    <errorDisplayField>RES_Unit_Preference__c</errorDisplayField>
    <errorMessage>Unit Preference is required when Lead Sub Status is Future Interest.</errorMessage>
</ValidationRule>
