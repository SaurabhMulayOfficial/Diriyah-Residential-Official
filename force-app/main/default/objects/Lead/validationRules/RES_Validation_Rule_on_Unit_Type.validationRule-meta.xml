<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Validation_Rule_on_Unit_Type</fullName>
    <active>true</active>
    <description>When Lead Sub Status is Qualified</description>
    <errorConditionFormula>AND(
    NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c),
    OR(
        $RecordType.DeveloperName = &quot;RES_Company&quot;,
        $RecordType.DeveloperName = &quot;RES_Individual&quot;
    ),
				ISPICKVAL(RES_Lead_Sub_Status__c, &quot;Qualified&quot;),
    ISBLANK(TEXT(RES_Unit_Type__c))
)</errorConditionFormula>
    <errorDisplayField>RES_Unit_Type__c</errorDisplayField>
    <errorMessage>Unit Type is required when Lead Sub Status is Qualified.</errorMessage>
</ValidationRule>
