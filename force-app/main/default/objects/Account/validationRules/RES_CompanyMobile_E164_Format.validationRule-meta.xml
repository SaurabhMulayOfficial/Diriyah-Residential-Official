<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_CompanyMobile_E164_Format</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
NOT($Setup.RES_Config_Switch__c.RES_Validation_Rules_Off__c ),
$RecordType.DeveloperName = &quot;RES_Company&quot;,
NOT(ISBLANK(CompanyMobilePhone__c)),
NOT(REGEX(CompanyMobilePhone__c, &quot;\\+\\d{10,15}&quot;))
)</errorConditionFormula>
    <errorDisplayField>CompanyMobilePhone__c</errorDisplayField>
    <errorMessage>Company Mobile number must be in E.164 format (e.g., +1234567890)</errorMessage>
</ValidationRule>
