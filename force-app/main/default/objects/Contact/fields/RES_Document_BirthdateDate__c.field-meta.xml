<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Document_BirthdateDate__c</fullName>
    <description>Birthdate as DD/MM/YYYY.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(Birthdate), &quot;&quot;,
LPAD(TEXT(DAY(Birthdate)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH(Birthdate)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
TEXT(YEAR(Birthdate)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Document Birthdate Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
