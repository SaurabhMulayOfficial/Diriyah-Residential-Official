<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Document_Unit_Handover_Date__c</fullName>
    <description>Unit handover date as DD/MM/YYYY.</description>
    <externalId>false</externalId>
    <formula>IF(ISBLANK(RES_Unit_Handover_Date__c), &quot;&quot;,
LPAD(TEXT(DAY(RES_Unit_Handover_Date__c)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
LPAD(TEXT(MONTH(RES_Unit_Handover_Date__c)), 2, &quot;0&quot;) &amp; &quot;/&quot; &amp;
TEXT(YEAR(RES_Unit_Handover_Date__c)))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Document Unit Handover Date</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
