  ISBLANK(RES_Default_Plan_Price__c),
  NULL,
  VALUE(SUBSTITUTE(LEFT(RES_Default_Plan_Price__c, FIND(&quot; &quot;, RES_Default_Plan_Price__c) - 1), &quot;,&quot;, &quot;&quot;))
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Default Price Number</label>
    <precision>18</precision>
    <required>false</required>
    <scale>2</scale>
