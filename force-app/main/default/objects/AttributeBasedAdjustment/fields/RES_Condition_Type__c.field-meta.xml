<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Condition_Type__c</fullName>
    <businessStatus>Active</businessStatus>
    <description>SAP condition type derived from the adjustment rule name: Option 1 = Y100, Option 2 = Y101. Used for reporting.</description>
    <externalId>false</externalId>
    <formula>IF(CONTAINS(AttributeBasedAdjRule.Name, &quot;Option 1&quot;), &quot;Y100&quot;,
IF(CONTAINS(AttributeBasedAdjRule.Name, &quot;Option 2&quot;), &quot;Y101&quot;, null))</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Condition Type</label>
    <required>false</required>
    <securityClassification>Internal</securityClassification>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
