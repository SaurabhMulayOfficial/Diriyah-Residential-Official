<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Stage_Change_Validation</fullName>
    <active>true</active>
    <description>You are only allowed to change the Opportunity Stage to &quot;Closed Lost&quot;.</description>
    <errorConditionFormula>AND(
    ISCHANGED(StageName),
    TEXT(StageName) &lt;&gt; &quot;Closed Lost&quot;,
    $Profile.Name &lt;&gt; &quot;System Administrator&quot;
)</errorConditionFormula>
    <errorDisplayField>StageName</errorDisplayField>
    <errorMessage>You are only allowed to change the Opportunity Stage to &quot;Closed Lost&quot;.</errorMessage>
</ValidationRule>
