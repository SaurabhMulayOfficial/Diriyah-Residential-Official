<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RES_Installment_Sort_Key__c</fullName>
    <description>Zero-padded installment sequence so document generation sorts installments numerically.</description>
    <formula>IF(ISBLANK(Product2.RES_Sequence__c), NULL, LPAD(TEXT(Product2.RES_Sequence__c), 3, &quot;0&quot;))</formula>
    <formulaTreatBlanksAs>BlankAsBlank</formulaTreatBlanksAs>
    <label>Installment Sort Key</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
