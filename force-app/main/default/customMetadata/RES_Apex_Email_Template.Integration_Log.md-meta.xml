        <value xsi:type="xsd:string">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;

&lt;style&gt;
html, body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    background: #eef1f6;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
}

table {
    border-collapse: collapse;
    border-spacing: 0;
}

td {
    font-family: Arial, Helvetica, sans-serif;
}

a {
    text-decoration: none;
}

/* =========================================================
   PAGE
========================================================= */

.page {
    width: 100%;
    background: #eef1f6;
    padding: 35px 10px;
}

.main {
    width: 600px;
    max-width: 600px;
    background: #ffffff;
    border-radius: 22px;
    overflow: hidden;
    border: 1px solid #dfe4ec;
}

/* =========================================================
   TOP NAV
========================================================= */

.nav {
    background: #10162b;
    padding: 16px 28px;
}

.nav-brand {
    color: #ffffff;
    font-size: 11px;
    line-height: 16px;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.nav-brand span {
    color: #7885ff;
}

.nav-right {
    color: #747d99;
    font-size: 9px;
    line-height: 14px;
    text-align: right;
    letter-spacing: 1px;
    text-transform: uppercase;
}

/* =========================================================
   HERO
========================================================= */

.hero {
    background: #10162b;
    padding: 30px 30px 34px;
}

.hero-left {
    width: 67%;
    vertical-align: middle;
}

.hero-right {
    width: 33%;
    vertical-align: middle;
    text-align: right;
}

.eyebrow {
    color: #8c97ff;
    font-size: 10px;
    line-height: 15px;
    font-weight: bold;
    letter-spacing: 1.8px;
    text-transform: uppercase;
}

.title {
    margin-top: 9px;
    color: #ffffff;
    font-size: 30px;
    line-height: 37px;
    font-weight: 800;
}

.title .accent {
    color: #ff7187;
}

.subtitle {
    margin-top: 11px;
    color: #a8b0c5;
    font-size: 12px;
    line-height: 20px;
    max-width: 355px;
}

/* =========================================================
   FUNNY BUT SOPHISTICATED ILLUSTRATION
========================================================= */

.scene {
    position: relative;
    display: inline-block;
    width: 145px;
    height: 125px;
}

.shadow {
    position: absolute;
    right: 8px;
    bottom: 4px;
    width: 105px;
    height: 12px;
    background: #0a0f20;
    border-radius: 50%;
}

/* monitor */

.monitor {
    position: absolute;
    right: 13px;
    top: 10px;
    width: 104px;
    height: 76px;
    background: #ffffff;
    border-radius: 11px;
    box-shadow: 0 14px 30px rgba(0,0,0,0.24);
}

.monitor-screen {
    position: absolute;
    left: 7px;
    top: 7px;
    width: 90px;
    height: 61px;
    background: #f1f3ff;
    border-radius: 6px;
}

.screen-top {
    position: absolute;
    left: 10px;
    top: 10px;
    width: 70px;
    height: 5px;
    background: #dce0f7;
    border-radius: 4px;
}

.screen-line-1,
.screen-line-2,
.screen-line-3 {
    position: absolute;
    left: 10px;
    height: 5px;
    border-radius: 4px;
}

.screen-line-1 {
    top: 24px;
    width: 47px;
    background: #cbd1ed;
}

.screen-line-2 {
    top: 34px;
    width: 61px;
    background: #d9ddf2;
}

.screen-line-3 {
    top: 44px;
    width: 38px;
    background: #e0e3f4;
}

.monitor-stand {
    position: absolute;
    right: 55px;
    top: 86px;
    width: 9px;
    height: 17px;
    background: #d8dce8;
}

.monitor-base {
    position: absolute;
    right: 42px;
    top: 101px;
    width: 35px;
    height: 6px;
    background: #c9cedb;
    border-radius: 6px;
}

/* alert bubble */

.alert-bubble {
    position: absolute;
    right: -2px;
    top: 0;
    width: 39px;
    height: 39px;
    line-height: 39px;
    text-align: center;
    background: #ff627b;
    color: #ffffff;
    border-radius: 50%;
    border: 4px solid #10162b;
    font-size: 19px;
    font-weight: bold;
}

/* little notification */

.notification {
    position: absolute;
    left: 2px;
    bottom: 21px;
    width: 58px;
    height: 37px;
    background: #ffffff;
    border-radius: 9px;
    box-shadow: 0 9px 20px rgba(0,0,0,0.18);
}

.notification-line {
    position: absolute;
    left: 9px;
    top: 9px;
    width: 35px;
    height: 5px;
    background: #dce1ee;
    border-radius: 4px;
}

.notification-dot {
    position: absolute;
    left: 9px;
    top: 21px;
    width: 8px;
    height: 8px;
    background: #ff627b;
    border-radius: 50%;
}

.notification-text {
    position: absolute;
    left: 23px;
    top: 20px;
    width: 27px;
    height: 5px;
    background: #e1e4ed;
    border-radius: 4px;
}

/* =========================================================
   CONTENT
========================================================= */

.content {
    padding: 28px 30px 30px;
}

/* =========================================================
   INTEGRATION HEADER
========================================================= */

.integration {
    width: 100%;
    padding-bottom: 21px;
    border-bottom: 1px solid #e8ebf1;
}

.integration-label {
    color: #8a92a6;
    font-size: 9px;
    line-height: 13px;
    font-weight: bold;
    letter-spacing: 1.5px;
    text-transform: uppercase;
}

.integration-name {
    margin-top: 5px;
    color: #1c2338;
    font-size: 20px;
    line-height: 26px;
    font-weight: 800;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.integration-meta {
    margin-top: 5px;
    color: #7c8499;
    font-size: 11px;
    line-height: 17px;
    overflow-wrap: anywhere;
    word-break: break-word;
}

.failed {
    display: inline-block;
    padding: 7px 11px;
    background: #fff0f2;
    color: #d74861;
    border-radius: 20px;
    font-size: 10px;
    line-height: 13px;
    font-weight: bold;
    white-space: nowrap;
}

/* =========================================================
   ERROR MESSAGE
========================================================= */

.error {
    margin-top: 23px;
}

.section-label {
    color: #4c556c;
    font-size: 10px;
    line-height: 14px;
    font-weight: bold;
    letter-spacing: 1.3px;
    text-transform: uppercase;
    margin-bottom: 9px;
}

.error-card {
    background: #fff8f9;
    border: 1px solid #f3dfe4;
    border-radius: 14px;
    padding: 16px;
}

.error-icon {
    width: 31px;
    vertical-align: top;
}

.error-icon-box {
    width: 27px;
    height: 27px;
    line-height: 27px;
    text-align: center;
    background: #ffe4e9;
    color: #d74760;
    border-radius: 8px;
    font-size: 13px;
    font-weight: bold;
}

.error-text {
    padding-left: 11px;
    color: #2b3043;
    font-size: 13px;
    line-height: 21px;
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* =========================================================
   DETAILS
========================================================= */

.details {
    margin-top: 23px;
}

.details-card {
    width: 100%;
    border: 1px solid #e4e8ef;
    border-radius: 14px;
    overflow: hidden;
}

.details-card td {
    padding: 12px 14px;
    border-bottom: 1px solid #edf0f4;
    font-size: 11px;
    line-height: 17px;
}

.details-card tr:last-child td {
    border-bottom: none;
}

.detail-label {
    width: 28%;
    background: #fafbfc;
    color: #8a92a6;
    vertical-align: top;
}

.detail-value {
    width: 72%;
    color: #222a3f;
    font-weight: bold;
    vertical-align: top;
    overflow-wrap: anywhere;
    word-break: break-word;
}

/* =========================================================
   CTA
========================================================= */

.cta {
    margin-top: 24px;
    background: #f3f4ff;
    border-radius: 15px;
    padding: 17px 18px;
    border: 1px solid #e0e3fb;
}

.cta-title {
    color: #252c46;
    font-size: 12px;
    line-height: 17px;
    font-weight: bold;
}

.cta-text {
    margin-top: 3px;
    color: #858da1;
    font-size: 10px;
    line-height: 15px;
}

.cta-button-cell {
    width: 150px;
    text-align: right;
    vertical-align: middle;
}

.cta-button {
    display: inline-block;
    padding: 11px 15px;
    background: #5965dc;
    color: #ffffff !important;
    border-radius: 9px;
    font-size: 10px;
    line-height: 15px;
    font-weight: bold;
    white-space: nowrap;
}

/* =========================================================
   FOOTER
========================================================= */

.footer {
    padding: 19px 25px;
    background: #f7f8fa;
    border-top: 1px solid #e8ebf0;
    text-align: center;
}

.footer-text {
    color: #8a92a5;
    font-size: 10px;
    line-height: 17px;
}

.footer-text strong {
    color: #596177;
}

/* =========================================================
   MOBILE
========================================================= */

