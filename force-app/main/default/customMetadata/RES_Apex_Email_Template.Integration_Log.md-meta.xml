    }

    .detail-label {
        width: 30% !important;
    }

    .detail-value {
        width: 70% !important;
    }


    /* -------------------------
       BUTTON
       ------------------------- */

    .button-area {
        padding: 20px 0 5px !important;
    }

    .button {
        padding: 12px 18px !important;
        font-size: 12px !important;
        line-height: 16px !important;
    }

    .arrow {
