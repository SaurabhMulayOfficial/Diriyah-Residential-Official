        <value xsi:type="xsd:string">&lt;!DOCTYPE html&gt;
&lt;html&gt;
&lt;head&gt;
&lt;meta charset=&quot;UTF-8&quot;&gt;
&lt;meta name=&quot;viewport&quot; content=&quot;width=device-width, initial-scale=1.0&quot;&gt;

&lt;style&gt;
/* =========================================================
   BASE
   ========================================================= */

html,
body {
    margin: 0 !important;
    padding: 0 !important;
    width: 100% !important;
    background: #ffffff;
    font-family: Arial, Helvetica, sans-serif;
    -webkit-text-size-adjust: 100%;
    -ms-text-size-adjust: 100%;
}

table {
    border-collapse: collapse;
    border-spacing: 0;
}

img {
    border: 0;
    outline: none;
    text-decoration: none;
    display: block;
}

td {
    font-family: Arial, Helvetica, sans-serif;
}


/* =========================================================
   PAGE
   ========================================================= */

.page {
    width: 100%;
    background: #ffffff;
    padding: 25px 10px;
}

.main {
    width: 600px;
    max-width: 600px;
    background: #ffffff;
    border: 1px solid #ffffff;
    border-radius: 24px;
    overflow: hidden;
}


/* =========================================================
   HERO
   ========================================================= */

.hero {
    background: #f4f8ff;
    padding: 30px 34px 25px;
}

.hero-table {
    width: 100%;
}

.hero-left {
    width: 62%;
    padding-right: 12px;
    vertical-align: middle;
}

.hero-right {
    width: 38%;
    text-align: right;
    vertical-align: middle;
}

.brand {
    font-size: 15px;
    line-height: 31px;
    font-weight: 600;
    color: #5269a1;
    white-space: nowrap;
}

.cloud {
    display: inline-block;
    width: 31px;
    height: 31px;
    line-height: 31px;
    text-align: center;
    background: #4d9df7;
    color: #ffffff;
    border-radius: 10px;
    margin-right: 8px;
    font-size: 16px;
    vertical-align: middle;
}

.hero-title {
    margin-top: 18px;
    font-size: 27px;
    line-height: 34px;
    font-weight: 800;
    color: #17245c;
}

.hero-title .oops {
    color: #ef4768;
}

.hero-description {
    margin-top: 10px;
    font-size: 14px;
    line-height: 22px;
    color: #5c6e9f;
    max-width: 370px;
}


/* =========================================================
   HERO ILLUSTRATION
   ========================================================= */

.illustration {
    text-align: right;
    font-size: 0;
}

.laptop-wrap {
    display: inline-block;
    position: relative;
    width: 150px;
    height: 100px;
}

.laptop {
    position: absolute;
    left: 0;
    top: 10px;
    width: 150px;
    height: 92px;
    background: #443de0;
    border-radius: 10px 10px 5px 5px;
    box-shadow: 0 8px 18px rgba(55, 60, 160, 0.20);
}

.screen {
    position: absolute;
    left: 8px;
    top: 8px;
    width: 134px;
    height: 72px;
    background: #fff0f7;
    border-radius: 5px;
}

.sad {
    font-size: 29px;
    color: #17245c;
    line-height: 45px;
    text-align: center;
    padding-top: 8px;
}

.sad-face {
    font-size: 22px;
    line-height: 20px;
}

.keyboard {
    position: absolute;
    bottom: -8px;
    left: -15px;
    width: 180px;
    height: 12px;
    background: #3834b7;
    border-radius: 0 0 12px 12px;
}

.alert {
    position: absolute;
    right: -8px;
    top: 0;
    width: 45px;
    height: 45px;
    line-height: 45px;
    text-align: center;
    border-radius: 50%;
    background: #f04468;
    border: 5px solid #ffffff;
    color: #ffffff;
    font-size: 23px;
    font-weight: bold;
    box-shadow: 0 5px 15px rgba(240, 68, 104, 0.20);
}


/* =========================================================
   CONTENT
   ========================================================= */

.content {
    padding: 26px 34px 30px;
}


/* =========================================================
   INTEGRATION CARD
   ========================================================= */

.integration {
    width: 100%;
    padding: 18px;
    background: #ffffff;
}

.integration-icon-cell {
    width: 60px;
    vertical-align: middle;
}

.integration-icon {
    width: 48px;
    height: 48px;
    line-height: 48px;
    text-align: center;
    border-radius: 14px;
    background: #28395f;
    color: #ffffff;
    font-size: 23px;
}

.integration-info {
    vertical-align: middle;
}

.label {
    font-size: 10px;
    line-height: 14px;
    letter-spacing: 1.3px;
    font-weight: bold;
    color: #6174aa;
    text-transform: uppercase;
}

.integration-name {
    margin-top: 4px;
    font-size: 21px;
    line-height: 26px;
    font-weight: 800;
    color: #17245c;

    overflow-wrap: anywhere;
    word-break: break-word;
}

.service {
    margin-top: 5px;
    font-size: 12px;
    line-height: 18px;
    color: #6677a5;

    overflow-wrap: anywhere;
    word-break: break-word;
}

.status-cell {
    width: 75px;
    text-align: right;
    vertical-align: middle;
}

.failed {
    display: inline-block;
    padding: 7px 11px;
    border-radius: 20px;
    background: #ffe8ef;
    color: #e84263;
    font-size: 12px;
    line-height: 14px;
    font-weight: bold;
    white-space: nowrap;
}


/* =========================================================
   ERROR
   ========================================================= */

.error {
    margin-top: 20px;
    padding: 18px;
    border-radius: 15px;
    background: #fff3f6;
}

.error-title {
    color: #c52c50;
    font-size: 11px;
    line-height: 15px;
    letter-spacing: 1.2px;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 7px;
}

.error-text {
    color: #18285f;
    font-size: 14px;
    line-height: 21px;

    overflow-wrap: anywhere;
    word-break: break-word;
}


/* =========================================================
   OBJECT DETAILS
   ========================================================= */

.details {
    margin-top: 20px;
    padding: 18px;
    border-radius: 15px;
    background: #f4f7ff;
}

.details-title {
    color: #5068a2;
    font-size: 11px;
    line-height: 15px;
    letter-spacing: 1.2px;
    font-weight: bold;
    text-transform: uppercase;
    margin-bottom: 12px;
}

.details-table {
    width: 100%;
    background: #ffffff;
    border-radius: 10px;
    overflow: hidden;
}

.details-table td {
    padding: 11px 13px;
    border-bottom: 1px solid #edf0f6;
    font-size: 12px;
    line-height: 17px;
}

.details-table tr:last-child td {
    border-bottom: none;
}

.detail-label {
    width: 32%;
    color: #7381a6;
    vertical-align: top;
}

.detail-value {
    width: 68%;
    color: #17245c;
    font-weight: bold;
    vertical-align: top;

    overflow-wrap: anywhere;
    word-break: break-word;
}


/* =========================================================
   BUTTON
   ========================================================= */

.button-area {
    text-align: center;
    padding: 25px 0 8px;
}

.button {
    display: inline-block;
    padding: 14px 26px;
    border-radius: 11px;
    background: #5148ff;
    color: #ffffff !important;
    text-decoration: none;
    font-size: 14px;
    line-height: 18px;
    font-weight: bold;
}

.arrow {
    font-size: 18px;
    margin-left: 8px;
    vertical-align: -1px;
}


/* =========================================================
   FOOTER
   ========================================================= */

.footer {
    background: #f2f6ff;
    padding: 23px 30px;
    text-align: center;
}

.footer-symbol {
    font-size: 20px;
    line-height: 22px;
    margin-bottom: 6px;
    color: #7588c0;
}

.footer-message {
    font-size: 11px;
    line-height: 18px;
    color: #7180a5;
}

.footer-message strong {
    color: #52658e;
}


/* =========================================================
   MOBILE
   ========================================================= */

