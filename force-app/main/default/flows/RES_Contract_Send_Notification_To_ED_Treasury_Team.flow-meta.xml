    <environments>Default</environments>
    <formulas>
        <name>approvalWorkItemURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_610},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_610})
)
&amp;
&quot;/&quot;
&amp;
{!Get_Approval_Work_Item.Id}</expression>
    </formulas>
    <formulas>
        <name>bellNotificationBody</name>
        <dataType>String</dataType>
        <expression>&quot;Contract &quot; &amp; {!contractNumber} &amp; &quot; requires your approval.&quot;</expression>
    </formulas>
    <formulas>
        <name>recordURL</name>
        <dataType>String</dataType>
