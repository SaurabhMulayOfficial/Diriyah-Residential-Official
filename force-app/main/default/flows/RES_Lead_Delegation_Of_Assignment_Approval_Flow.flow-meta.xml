    <decisions>
        <name>check_if_approval_Items_are_not_null</name>
        <label>check if approval Items are not null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Approval_Required_from_the_Last_Approver_s_Manager</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Query_Approval_Work_Item.Outputs.workItemId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <label>Null</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Manager_Level</name>
        <label>Check Manager Level</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Record_Has_been_Approved</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Check_Role</name>
            <conditionLogic>1 OR (2 AND 3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>Query_Approval_Work_Item.Outputs.workItemId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Query_Approval_Work_Item.Outputs.userRole</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>RES_Sales_Enterprise_Chief_Sales_Office</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Query_Approval_Work_Item.Outputs.Profile</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>System Administrator</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Query_Approval_Work_Item.Outputs.status</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>check_if_approval_Items_are_not_null</targetReference>
            </connector>
            <label>Check Role</label>
        </rules>
    </decisions>
    <decisions>
        <name>if_proposed_owner_is_not_null</name>
        <label>if proposed owner is not null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>if_proposed_owner_is_not_null_changed_Owner_manager_not_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.RES_Proposed_User__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.RES_Proposed_User__c</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Owner:User.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>InitialFirstApproval</targetReference>
            </connector>
            <label>if proposed owner is not null &amp; changed Owner manager not null</label>
        </rules>
    </decisions>
