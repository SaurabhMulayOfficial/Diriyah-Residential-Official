    <formulas>
        <name>approvalWorkItemURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_610},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_610})
)
&amp;
&quot;/&quot;
&amp;
{!$Record.Id}</expression>
    </formulas>
    <formulas>
        <name>contractURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_610},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_610})
)
&amp;
&quot;/&quot;
&amp;
{!Get_Related_Contract.Id}</expression>
    </formulas>
    <formulas>
        <name>slaEndDateFormula</name>
        <dataType>String</dataType>
        <expression>RIGHT(&quot;0&quot; &amp; TEXT(DAY(DATEVALUE({!$Record.RES_SLA_End_Date__c}))), 2)
&amp; &quot;-&quot;
&amp; CASE(
    MONTH(DATEVALUE({!$Record.RES_SLA_End_Date__c})),
    1, &quot;Jan&quot;,
    2, &quot;Feb&quot;,
    3, &quot;Mar&quot;,
    4, &quot;Apr&quot;,
    5, &quot;May&quot;,
    6, &quot;Jun&quot;,
    7, &quot;Jul&quot;,
    8, &quot;Aug&quot;,
    9, &quot;Sep&quot;,
    10, &quot;Oct&quot;,
    11, &quot;Nov&quot;,
    12, &quot;Dec&quot;,
    &quot;&quot;
)
&amp; &quot;-&quot;
&amp; TEXT(YEAR(DATEVALUE({!$Record.RES_SLA_End_Date__c})))
&amp; &quot; at &quot;
&amp; IF(
    HOUR(TIMEVALUE({!$Record.RES_SLA_End_Date__c})) = 0,
    &quot;12&quot;,
    IF(
        HOUR(TIMEVALUE({!$Record.RES_SLA_End_Date__c})) &gt; 12,
        TEXT(HOUR(TIMEVALUE({!$Record.RES_SLA_End_Date__c})) - 12),
        TEXT(HOUR(TIMEVALUE({!$Record.RES_SLA_End_Date__c})))
    )
)
&amp; &quot;:&quot;
&amp; RIGHT(&quot;0&quot; &amp; TEXT(MINUTE(TIMEVALUE({!$Record.RES_SLA_End_Date__c}))), 2)
&amp; &quot; &quot;
&amp; IF(
    HOUR(TIMEVALUE({!$Record.RES_SLA_End_Date__c})) &gt;= 12,
    &quot;PM&quot;,
    &quot;AM&quot;
)</expression>
    </formulas>
