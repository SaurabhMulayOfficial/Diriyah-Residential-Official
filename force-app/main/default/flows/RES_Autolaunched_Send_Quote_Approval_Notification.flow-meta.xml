<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>DIR-869: Sends a bell notification (first, reliably) then a formatted HTML email for the Quote Discount DOA. Recipient is a user (recipientId + emailAddress) or a queue (recipientQueueName -> members get bell + email). Email is greeting + emailBodyDetail (which carries the hyperlinked Quote) + sign-off. Fully fault-tolerant so a notification/email error can never break the calling approval orchestration.</description>
    <environments>Default</environments>
    <interviewLabel>RES Send Quote Approval Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Autolaunched Send Quote Approval Notification</label>
    <processType>AutoLaunchedFlow</processType>
    <formulas>
        <name>fRecipient</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!recipientQueueName}), {!recipientId}, {!Get_Queue.Id})</expression>
    </formulas>
    <formulas>
        <name>fSubject</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!emailSubject}), "Quote Discount Approval Required", {!emailSubject})</expression>
    </formulas>
    <formulas>
        <name>fEmailHtml</name>
        <dataType>String</dataType>
        <expression>"Dear " &amp; {!greetingName} &amp; ",&lt;br/&gt;&lt;br/&gt;" &amp; {!emailBodyDetail} &amp; "&lt;br/&gt;&lt;br/&gt;Thanks,&lt;br/&gt;Diriyah Residential Sales Operations"</expression>
    </formulas>
