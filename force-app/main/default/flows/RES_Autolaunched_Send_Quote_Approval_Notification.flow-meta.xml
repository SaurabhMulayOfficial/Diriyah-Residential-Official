<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <description>DIR-869: Sends a bell notification (first, reliably) then a template-driven HTML email for the Quote Discount DOA, using the org's configurable email functionality (RES_Apex_Email_Template__mdt + RES_SendEmailInvocable / RES_EmailUtilityService / RES_EmailService), matching the same pattern already used by the Soft Hold and Contract KYC approval flows. Recipient is a user (recipientId) or a queue (recipientQueueName -> members get bell + email). When decision is blank, the Quote_Discount_Approval_Request template is used (submission to an approver); when decision is Approved/Rejected, the Quote_Discount_Approval_Decision template is used (outcome to the submitter). Fully fault-tolerant so a notification/email error can never break the calling approval orchestration.</description>
    <environments>Default</environments>
    <interviewLabel>RES Send Quote Approval Notification {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Autolaunched Send Quote Approval Notification</label>
    <processType>AutoLaunchedFlow</processType>
    <formulas>
        <name>fRecipient</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!recipientQueueName}), {!recipientId}, {!Get_Queue.Id})</expression>
    </formulas>
    <formulas>
        <name>fOwnerName</name>
        <dataType>String</dataType>
        <expression>{!Get_Quote.Owner:User.FirstName} &amp; &quot; &quot; &amp; {!Get_Quote.Owner:User.LastName}</expression>
    </formulas>
    <formulas>
        <name>fDiscountAmount</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Quote.Subtotal} - {!Get_Quote.GrandTotal})</expression>
    </formulas>
    <formulas>
        <name>fDiscountPercent</name>
        <dataType>String</dataType>
        <expression>TEXT({!Get_Quote.Discount})</expression>
    </formulas>
    <formulas>
        <name>fQuoteURL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_600}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_600})) &amp;
&quot;/lightning/r/Quote/&quot; &amp;
{!recordId} &amp;
&quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>fGreetingName</name>
        <dataType>String</dataType>
        <description>DIR-1612: "Team" for a queue recipient (multiple people); the actual recipient's name for an individual recipient (e.g. the Sales Manager), instead of the previous hardcoded "Team" greeting used for both.</description>
        <expression>IF(ISBLANK({!recipientQueueName}), BLANKVALUE({!Get_Recipient_User.Name}, &quot;Team&quot;), &quot;Team&quot;)</expression>
    </formulas>
