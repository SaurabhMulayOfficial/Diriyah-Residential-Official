        <expression>LEFT(
    {!$Api.Partner_Server_URL_600},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_600}) - 1
) &amp;
&quot;/lightning/r/&quot; &amp;
{!$Record.Id} &amp;
&quot;/view&quot;</expression>
    </formulas>
