    <decisions>
        <name>check_Approval_Type</name>
        <label>check Approval Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>If_ApprovalEmails</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>approvalAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ApprovalEmails</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Group</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>If_Group_is_Not_Null</targetReference>
            </connector>
            <label>If &quot;ApprovalEmails&quot;</label>
        </rules>
        <rules>
            <name>If_Approve</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>approvalAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Approve</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Group</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Hydrate_Merge_Fields</targetReference>
            </connector>
            <label>If &quot;Approve&quot;</label>
        </rules>
        <rules>
            <name>If_Reject</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>approvalAction</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Reject</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Contract_Details</targetReference>
            </connector>
            <label>If &quot;Reject&quot;</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_if_Approval_has_been_raised</name>
        <label>Check if Approval has been raised</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes_Approval_Raised</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Approval_Work_Item</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Populate_Merge_Fields</targetReference>
            </connector>
            <label>Yes Approval Raised</label>
        </rules>
    </decisions>
    <decisions>
        <name>If_Group_is_Not_Null</name>
        <label>If Group is Not Null</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Not_Null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Group</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Approval_Work_Item</targetReference>
            </connector>
            <label>Not Null</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>awiURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_620},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_620}) - 1
) &amp;
&quot;/lightning/r/ApprovalWorkItem/&quot; &amp;
{!Get_Approval_Work_Item.Id} &amp;
&quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>contractURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_620},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_620}) - 1
) &amp;
&quot;/lightning/r/Contract/&quot; &amp;
{!recordId} &amp;
&quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>groupAPIName</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!recipientGroup},
    &quot;Finance&quot;, &quot;RES_Finance_Team_Group&quot;,
    &quot;EDTreasury&quot;, &quot;RES_Executive_Director_Treasury&quot;,
    &quot;CBDO&quot;, &quot;RES_Chief_Business_Development_Officer&quot;,
    &quot;&quot;
)</expression>
    </formulas>
    <formulas>
        <name>Team</name>
        <dataType>String</dataType>
        <expression>CASE(
    {!recipientGroup},
    &quot;Finance&quot;, &quot;Finance Team&quot;,
    &quot;EDTreasury&quot;, &quot;ED Treasury Team&quot;,
    &quot;CBDO&quot;, &quot;Chief Business Development Officer&quot;,
    &quot;&quot;
)</expression>
    </formulas>
