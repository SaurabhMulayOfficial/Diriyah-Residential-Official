    <formulas>
        <name>ApprovalBody</name>
        <dataType>String</dataType>
        <expression>&apos;KYC for Contract &apos; +  {!Get_Contract.ContractNumber} +  &apos; has been &apos; + {!ApprovalStatus} + &apos;.&apos;  + &apos;Please review the contract for more details.&apos;</expression>
    </formulas>
    <formulas>
        <name>ApprovalStatus</name>
        <dataType>String</dataType>
        <expression>IF({!action} == &apos;Approve&apos;, &apos;Approved&apos;, &apos;Rejected&apos;)</expression>
    </formulas>
    <formulas>
        <name>ContractRecipient</name>
        <dataType>String</dataType>
        <expression>{!Get_Contract.Owner.FirstName} + &apos; &apos; + {!Get_Contract.Owner.LastName}</expression>
    </formulas>
    <formulas>
        <name>ContractURL</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_600}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_600})) &amp;
&quot;/lightning/r/Contract/&quot; &amp;
{!recordId} &amp;
&quot;/view&quot;</expression>
    </formulas>
    <formulas>
