    <decisions>
        <name>Check_DGP_Status</name>
        <label>Check DGP Status</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Show_Generating</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Still In Progress</defaultConnectorLabel>
        <rules>
            <name>DGP_Succeeded</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_DGP_Status.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Success</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Success</targetReference>
            </connector>
            <label>DGP Succeeded</label>
        </rules>
        <rules>
            <name>DGP_Failed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_DGP_Status.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Failure</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Show_Generation_Failed</targetReference>
            </connector>
            <label>DGP Failed</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Templates</name>
