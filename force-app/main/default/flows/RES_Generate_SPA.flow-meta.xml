    <formulas>
        <name>Project</name>
        <dataType>String</dataType>
        <expression>{!Get_Unit_CIP.RES_Product__r.RES_Business_Entity__r.Name}</expression>
    </formulas>
    <formulas>
        <name>requestText</name>
        <dataType>String</dataType>
        <expression>&quot;{\&quot;keepIntermediate\&quot;:false,&quot;
&amp; &quot;\&quot;title\&quot;:\&quot;SPA_&quot;
&amp; {!recordId.ContractNumber}
&amp; &quot;_&quot;
&amp; SUBSTITUTE(SUBSTITUTE(SUBSTITUTE({!templateName}, &quot;\&quot;&quot;, &quot;&quot;), &quot;\\&quot;, &quot;&quot;), &quot; &quot;, &quot;_&quot;)
&amp; &quot;_&quot;
&amp; TEXT(TODAY())
&amp; &quot;\&quot;}&quot;</expression>
    </formulas>
