    <decisions>
        <name>Deactivation_Approval_Outcome</name>
        <label>Deactivation Approval Outcome</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deactivation_Approved</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Deactivation_Approval_Step.Outputs.approvalDecision</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
