    <decisions>
        <name>Flows_Enabled</name>
        <label>Flows Enabled</label>
        <locationX>314</locationX>
        <locationY>134</locationY>
        <defaultConnectorLabel>Flows Off</defaultConnectorLabel>
        <rules>
            <name>Enabled</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.RES_Config_Switch__c.RES_Flows_Off__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Customer_Category</targetReference>
            </connector>
            <label>Enabled</label>
        </rules>
    </decisions>
    <decisions>
        <name>Customer_Category</name>
        <label>Customer Category</label>
        <locationX>314</locationX>
        <locationY>242</locationY>
        <defaultConnector>
            <targetReference>Set_Foreign_Customer</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Foreign</defaultConnectorLabel>
        <rules>
            <name>Saudi_Arabia</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.BillingCountryCode</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SA</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_Local_Customer</targetReference>
            </connector>
            <label>Saudi Arabia</label>
        </rules>
        <rules>
            <name>GCC</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fIsGCCCountry</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Set_GCC_Customer</targetReference>
            </connector>
            <label>GCC</label>
        </rules>
    </decisions>
    <description>Before save on Account. When the billing country is set on create or changed on update, sets Type, RES_Account_Group__c and RES_Planning_Group__c: SA = Z001/Y1 (Local), country in label RES_GCC_Country_Codes = Z002/Y2 (GCC), any other = Z003/Y3 (Foreign). Honours the RES_Config_Switch__c.RES_Flows_Off__c kill switch.</description>
    <environments>Default</environments>
    <formulas>
        <name>fIsGCCCountry</name>
        <dataType>Boolean</dataType>
        <expression>CONTAINS(&quot;,&quot; &amp; SUBSTITUTE({!$Label.RES_GCC_Country_Codes}, &quot; &quot;, &quot;&quot;) &amp; &quot;,&quot;, &quot;,&quot; &amp; TEXT({!$Record.BillingCountryCode}) &amp; &quot;,&quot;)</expression>
    </formulas>
    <interviewLabel>RES Account Before Insert Update Set Customer Group {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Account Before Insert Update Set Customer Group</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>188</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Flows_Enabled</targetReference>
        </connector>
        <filterFormula>AND(NOT(ISBLANK(TEXT({!$Record.BillingCountryCode}))), OR(ISNEW(), ISCHANGED({!$Record.BillingCountryCode})))</filterFormula>
        <object>Account</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordBeforeSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
