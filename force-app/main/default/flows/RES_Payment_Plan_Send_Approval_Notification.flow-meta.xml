    <description>DIR-1258: Generic "notify the approver group" step for the Payment Plan approval Flow Orchestrations (New Submission / Modification / Deactivation). Self-contained (does NOT delegate to RES_Autolaunched_Flow_Send_Notification_To_Public_Group) because that shared component's email path is gated behind an ApprovalWorkItem lookup (RelatedRecordId + Status='Assigned') that silently no-ops if no match is found - and in this orchestration, the notify step always runs BEFORE the approval step that would create that AWI, so email always failed while bell (no such gate) worked. Bell still uses the same customNotificationAction pattern; email is sent directly via RES_SendEmailInvocable without any AWI dependency.</description>
    <environments>Default</environments>
    <formulas>
        <name>recordURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_610},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_610})
)
&amp;
&quot;/&quot;
&amp;
{!recordId}</expression>
    </formulas>
    <formulas>
        <name>fSubmitterName</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!Get_Submitter.Name}, &quot;Submitter&quot;)</expression>
    </formulas>
    <formulas>
        <name>fSubmissionComments</name>
        <dataType>String</dataType>
        <expression>BLANKVALUE({!submissionComments}, &quot;No comments were provided.&quot;)</expression>
    </formulas>
    <formulas>
        <name>fIsSubGroup</name>
        <dataType>Boolean</dataType>
        <expression>LEFT({!Loop_On_Members.UserOrGroupId}, 3) = &quot;00G&quot;</expression>
    </formulas>
