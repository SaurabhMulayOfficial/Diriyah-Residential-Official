    <formulas>
        <name>LeadLink</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_610},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_610})
)
&amp;
&quot;/&quot;
&amp;
{!LeadRecord.Id}</expression>
    </formulas>
    <formulas>
        <name>oppLink</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_260}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_260})-1)  &amp; &quot;/lightning/r/Opportunity/&quot; &amp;  {!opportunityRecord.Id} &amp; &quot;/view&quot;</expression>
    </formulas>
    <formulas>
        <name>OpportunityURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_670},
    FIND(&apos;/services&apos;, {!$Api.Partner_Server_URL_670}) - 1
)
&amp; &apos;/lightning/r/Opportunity/&apos;
&amp; {!opportunityRecord.Id}
&amp; &apos;/view&apos;</expression>
    </formulas>
    <formulas>
        <name>oppWonNotificationBody</name>
        <dataType>String</dataType>
        <expression>{!ownerName} &amp; &quot; has Closed Won &quot; &amp; {!opportunityRecord.Name} &amp; &quot;. Please review.&quot;</expression>
    </formulas>
    <formulas>
        <name>OrgBaseUrl</name>
        <dataType>String</dataType>
        <expression>LEFT({!$Api.Partner_Server_URL_370}, FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_370}))</expression>
    </formulas>
    <formulas>
        <name>slaDueDate</name>
