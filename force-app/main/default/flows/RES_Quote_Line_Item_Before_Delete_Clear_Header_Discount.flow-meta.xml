<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Is_Quote_Negotiating</name>
        <label>Is Quote Negotiating</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Not Negotiating - Do Nothing</defaultConnectorLabel>
        <rules>
            <name>Yes_Negotiating</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote.Status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Negotiating</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Revert_Quote_To_Draft</targetReference>
            </connector>
            <label>Yes, Negotiating</label>
        </rules>
    </decisions>
    <description>DIR-869: If the root (commercial) line item on a Quote is deleted while the Quote is still in Negotiating (a discount was applied on the line item but never submitted for approval - RES_Quote_Line_Item_After_Save_Sync_Discount is what put it in Negotiating in the first place), reverts the Quote back to Draft and clears AppliedDiscount/AppliedDiscountAmount/AdjustmentDistributionLogic - so Manage Header Adjustment shows nothing left over from a line item that no longer exists. Deliberately scoped to Negotiating only: a Quote already Pending Approval, Approved, or Rejected is mid/post approval-process and deleting a line item there is a different scenario, not handled here. Runs Before Delete so it can still read the line item&apos;s own fields (ParentQuoteLineItemId, QuoteId) while looking up and updating the unrelated parent Quote record - the &quot;before&quot; restriction only applies to the record being deleted itself.</description>
    <environments>Default</environments>
    <interviewLabel>RES Quote Line Item - Before Delete - Clear Header Discount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Quote Line Item - Before Delete - Clear Header Discount</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Quote_Negotiating</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.QuoteId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Revert_Quote_To_Draft</name>
        <label>Revert Quote To Draft</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Quote.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AdjustmentDistributionLogic</field>
            <value>
                <elementReference>varEmptyString</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AppliedDiscount</field>
            <value>
                <elementReference>varEmptyNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>AppliedDiscountAmount</field>
            <value>
                <elementReference>varEmptyNumber</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Draft</stringValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Quote</targetReference>
        </connector>
        <filterFormula>ISBLANK({!$Record.ParentQuoteLineItemId})</filterFormula>
        <object>QuoteLineItem</object>
        <recordTriggerType>Delete</recordTriggerType>
        <triggerType>RecordBeforeDelete</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <name>varEmptyNumber</name>
        <dataType>Number</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <scale>2</scale>
    </variables>
    <variables>
        <name>varEmptyString</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
