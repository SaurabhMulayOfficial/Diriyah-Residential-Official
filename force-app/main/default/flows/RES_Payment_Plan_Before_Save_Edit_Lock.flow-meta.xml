    <formulas>
        <description>DIR-1258: what RES_Pending_Name__c should become on this save. If Name was actually edited this transaction, capture the new value; otherwise preserve whatever was already staged from an earlier save (so a second unrelated edit before Submit doesn&apos;t wipe out the first one).</description>
        <name>PendingCandidate_Name</name>
        <dataType>String</dataType>
        <expression>IF(ISCHANGED({!$Record.Name}), {!$Record.Name}, {!$Record.RES_Pending_Name__c})</expression>
