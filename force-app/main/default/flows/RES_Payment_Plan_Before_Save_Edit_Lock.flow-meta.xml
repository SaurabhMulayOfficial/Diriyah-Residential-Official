    <recordLookups>
        <name>Get_Linked_Contract_Item_Price</name>
        <label>Get Linked Contract Item Price</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Was_Approved_And_Changed</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
