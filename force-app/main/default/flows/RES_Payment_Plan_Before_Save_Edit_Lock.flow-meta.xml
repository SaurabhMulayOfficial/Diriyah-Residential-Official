        <scale>0</scale>
    </formulas>
    <formulas>
        <name>PendingCandidate_ParentPaymentPlan</name>
        <dataType>String</dataType>
        <expression>IF(ISCHANGED({!$Record.RES_Parent_Payment_Plan__c}), {!$Record.RES_Parent_Payment_Plan__c}, {!$Record.RES_Pending_Parent_Payment_Plan__c})</expression>
    </formulas>
    <formulas>
        <name>PendingCandidate_ProductCode</name>
        <dataType>String</dataType>
        <expression>IF(ISCHANGED({!$Record.ProductCode}), {!$Record.ProductCode}, {!$Record.RES_Pending_Product_Code__c})</expression>
    </formulas>
    <formulas>
        <name>PendingCandidate_Version</name>
        <dataType>Number</dataType>
        <expression>IF(ISCHANGED({!$Record.RES_Version__c}), {!$Record.RES_Version__c}, {!$Record.RES_Pending_Version__c})</expression>
        <scale>2</scale>
    </formulas>
