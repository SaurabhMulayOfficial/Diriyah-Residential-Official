    <description>DIR-1258 AC5/AC6/AC7: Blocks routine edits to a Residential Payment Plan Product2 record once it is assigned to a Sales Contract (a ContractItemPrice exists with RES_Product__c = this record and RES_Payment_Plan_Check__c = true, per the DIR-868 CIP model). Permitted post-assignment changes: IsActive (deactivate), RES_Validity_End_Date__c, RES_Business_Entity__c (project reassignment), and the approval-engine&apos;s own status/flag fields (so the New Submission / Modification / Deactivation orchestrations are never blocked by their own writes). RES_AR_Payment_Plan_Unit_Override bypasses the lock entirely for the AR team&apos;s post-execution unit-specific changes (AC7).</description>
    <environments>Default</environments>
    <formulas>
        <description>DIR-1258: NOT(ISCHANGED(IsActive)) excludes the system's own Finalize_Modification/Discard_Modification/Stage_Modification commits, all of which flip IsActive in the same transaction as part of resolving a modification - without this guard, Finalize_Modification's own field commit (Approved status, tracked fields genuinely changing) would satisfy this formula and re-trigger the save-time staging logic recursively, undoing the very commit it just made. A genuine user edit on an already-active Approved record never touches IsActive, so this doesn't affect real edits.</description>
        <name>fShouldFlagModified</name>
        <dataType>Boolean</dataType>
        <expression>AND(
    ISPICKVAL({!$Record.RES_Approval_Status__c}, &quot;Approved&quot;),
    NOT(ISCHANGED({!$Record.IsActive})),
    {!HasModificationTriggerFieldChange}
)</expression>
    </formulas>
    <formulas>
        <name>HasDisallowedFieldChange</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISCHANGED({!$Record.Name}),
    ISCHANGED({!$Record.RES_No_of_Years__c}),
    ISCHANGED({!$Record.RES_Sequence__c}),
    ISCHANGED({!$Record.RES_POC_Percentage__c}),
    ISCHANGED({!$Record.RES_Installment_Percentage__c}),
    ISCHANGED({!$Record.RES_Installment_Amount__c}),
    ISCHANGED({!$Record.RES_Price_Option__c}),
    ISCHANGED({!$Record.Description})
)</expression>
    </formulas>
    <formulas>
        <description>DIR-1258: the 10-field list that triggers the Modification staged-change flow (Submit button reappearance + staging on submit). Deliberately separate from HasDisallowedFieldChange, which still gates the unrelated Sales-Contract edit lock with its own 8-field list.</description>
        <name>HasModificationTriggerFieldChange</name>
        <dataType>Boolean</dataType>
        <expression>OR(
    ISCHANGED({!$Record.Name}),
    ISCHANGED({!$Record.RES_No_of_Years__c}),
    ISCHANGED({!$Record.Description}),
    ISCHANGED({!$Record.AvailabilityDate}),
    ISCHANGED({!$Record.DiscontinuedDate}),
    ISCHANGED({!$Record.RES_Business_Entity__c}),
    ISCHANGED({!$Record.ProductCode}),
    ISCHANGED({!$Record.RES_Version__c}),
    ISCHANGED({!$Record.RES_Construction_Phase__c}),
    ISCHANGED({!$Record.RES_Parent_Payment_Plan__c})
)</expression>
    </formulas>
    <formulas>
        <description>DIR-1258: banner shown immediately on save (before Submit for Approval is ever clicked). Diffs the just-captured RES_Pending_* values (set moments earlier by Capture_Modification, in this same transaction) against the RES_Approved_* baseline. DateTime fields get a +3 hour offset before TEXT() since Flow&apos;s TEXT() renders DateTime in GMT, not the Asia/Riyadh (UTC+3) timezone this org&apos;s users are on - without it, an edited time displays confusingly close to the old value.</description>
        <name>InterimBannerText</name>
        <dataType>String</dataType>
        <expression>&quot;Payment Plan has been modified. Submit for approval to initiate the review process and apply these changes.&quot; &amp;
&quot;~~NL~~&quot; &amp; &quot;Field/s modified - &quot; &amp;
MID(
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Name__c})), BLANKVALUE({!$Record.RES_Pending_Name__c},&quot;&quot;) &lt;&gt; BLANKVALUE({!$Record.RES_Approved_Name__c},&quot;&quot;)),
    &quot;, Name: &quot; &amp; {!$Record.RES_Pending_Name__c}, &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_No_Of_Years__c})), BLANKVALUE(TEXT({!$Record.RES_Pending_No_Of_Years__c}),&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT({!$Record.RES_Approved_No_Of_Years__c}),&quot;&quot;)),
    &quot;, No of Years: &quot; &amp; TEXT({!$Record.RES_Pending_No_Of_Years__c}), &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Description__c})), BLANKVALUE({!$Record.RES_Pending_Description__c},&quot;&quot;) &lt;&gt; BLANKVALUE({!$Record.RES_Approved_Description__c},&quot;&quot;)),
    &quot;, Description: &quot; &amp; {!$Record.RES_Pending_Description__c}, &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Availability_Date__c})), BLANKVALUE(TEXT(IF(ISBLANK({!$Record.RES_Pending_Availability_Date__c}), {!$Record.RES_Pending_Availability_Date__c}, {!$Record.RES_Pending_Availability_Date__c} + (3/24))),&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT(IF(ISBLANK({!$Record.RES_Approved_Availability_Date__c}), {!$Record.RES_Approved_Availability_Date__c}, {!$Record.RES_Approved_Availability_Date__c} + (3/24))),&quot;&quot;)),
    &quot;, Availability Date: &quot; &amp; TEXT(IF(ISBLANK({!$Record.RES_Pending_Availability_Date__c}), {!$Record.RES_Pending_Availability_Date__c}, {!$Record.RES_Pending_Availability_Date__c} + (3/24))), &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Discontinued_Date__c})), BLANKVALUE(TEXT(IF(ISBLANK({!$Record.RES_Pending_Discontinued_Date__c}), {!$Record.RES_Pending_Discontinued_Date__c}, {!$Record.RES_Pending_Discontinued_Date__c} + (3/24))),&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT(IF(ISBLANK({!$Record.RES_Approved_Discontinued_Date__c}), {!$Record.RES_Approved_Discontinued_Date__c}, {!$Record.RES_Approved_Discontinued_Date__c} + (3/24))),&quot;&quot;)),
    &quot;, Discontinued Date: &quot; &amp; TEXT(IF(ISBLANK({!$Record.RES_Pending_Discontinued_Date__c}), {!$Record.RES_Pending_Discontinued_Date__c}, {!$Record.RES_Pending_Discontinued_Date__c} + (3/24))), &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Business_Entity__c})), BLANKVALUE({!$Record.RES_Pending_Business_Entity__c},&quot;&quot;) &lt;&gt; BLANKVALUE({!$Record.RES_Approved_Business_Entity__c},&quot;&quot;)),
    &quot;, Business Entity: &quot; &amp; BLANKVALUE({!Get_Pending_Business_Entity_Name.Name},&quot;&quot;), &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Product_Code__c})), BLANKVALUE({!$Record.RES_Pending_Product_Code__c},&quot;&quot;) &lt;&gt; BLANKVALUE({!$Record.RES_Approved_Product_Code__c},&quot;&quot;)),
    &quot;, Product Code: &quot; &amp; {!$Record.RES_Pending_Product_Code__c}, &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Version__c})), BLANKVALUE(TEXT({!$Record.RES_Pending_Version__c}),&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT({!$Record.RES_Approved_Version__c}),&quot;&quot;)),
    &quot;, Version: &quot; &amp; TEXT({!$Record.RES_Pending_Version__c}), &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK(TEXT({!$Record.RES_Pending_Construction_Phase__c}))), BLANKVALUE(TEXT({!$Record.RES_Pending_Construction_Phase__c}),&quot;&quot;) &lt;&gt; BLANKVALUE(TEXT({!$Record.RES_Approved_Construction_Phase__c}),&quot;&quot;)),
    &quot;, Construction Phase: &quot; &amp; TEXT({!$Record.RES_Pending_Construction_Phase__c}), &quot;&quot;) &amp;
IF(AND(NOT(ISBLANK({!$Record.RES_Pending_Parent_Payment_Plan__c})), BLANKVALUE({!$Record.RES_Pending_Parent_Payment_Plan__c},&quot;&quot;) &lt;&gt; BLANKVALUE({!$Record.RES_Approved_Parent_Payment_Plan__c},&quot;&quot;)),
    &quot;, Parent Payment Plan: &quot; &amp; BLANKVALUE({!Get_Pending_Parent_Payment_Plan_Name.Name},&quot;&quot;), &quot;&quot;)
, 3, 9999)</expression>
    </formulas>
    <formulas>
        <name>PendingCandidate_AvailabilityDate</name>
