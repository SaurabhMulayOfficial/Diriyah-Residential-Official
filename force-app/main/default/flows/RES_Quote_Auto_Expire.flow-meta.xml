<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>DIR-763: Daily scheduled job. Sets Status = Expired (and ExpirationDate = today, via the system bypass flag) on every Quote that is NOT the Primary Quote (IsSyncing = false) and has not been modified in more than 3 months (90 days). Already-Expired quotes are skipped so they are not reprocessed. Cancelled and Customer Approved quotes are also skipped because RES_LockCancelledQuote / RES_QuoteCustomerApprovedLockHandler lock them against edits (DIR-2225). Faults on either update are logged to RES_Integration_Log__c (which emails the integration admins) instead of surfacing as an unhandled flow error. Once Expired, RES_Expired_Quote_Locked makes the quote read-only (cannot be used), and RES_System_Statuses_Locked prevents anyone from manually setting Status back to Expired.</description>
    <environments>Default</environments>
    <formulas>
        <name>fThreshold</name>
        <dataType>DateTime</dataType>
        <expression>{!$Flow.CurrentDateTime} - 90</expression>
    </formulas>
    <interviewLabel>RES Quote Auto Expire {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Quote Auto Expire</label>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <name>Log_Expire_Failure</name>
        <label>Log Expire Failure</label>
        <locationX>440</locationX>
        <locationY>276</locationY>
        <inputAssignments>
            <field>RES_Class_Method__c</field>
            <value>
                <stringValue>RES_Quote_Auto_Expire (Flow) - Expire Old Non-Primary Quotes</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_Error_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_Object_Name__c</field>
            <value>
                <stringValue>Quote</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_Request_Name__c</field>
            <value>
                <stringValue>RES Quote Auto Expire</stringValue>
            </value>
        </inputAssignments>
        <object>RES_Integration_Log__c</object>
    </recordCreates>
    <recordCreates>
        <name>Log_Reset_Failure</name>
        <label>Log Reset Failure</label>
        <locationX>440</locationX>
        <locationY>384</locationY>
        <inputAssignments>
            <field>RES_Class_Method__c</field>
            <value>
                <stringValue>RES_Quote_Auto_Expire (Flow) - Reset System Flag</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_Error_Message__c</field>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_Object_Name__c</field>
            <value>
                <stringValue>Quote</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_Request_Name__c</field>
            <value>
                <stringValue>RES Quote Auto Expire</stringValue>
            </value>
        </inputAssignments>
        <object>RES_Integration_Log__c</object>
    </recordCreates>
    <recordUpdates>
        <name>Expire_Old_Non_Primary_Quotes</name>
        <label>Expire Old Non-Primary Quotes</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <connector>
            <targetReference>Reset_System_Flag</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Expire_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>IsSyncing</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Cancelled</stringValue>
            </value>
        </filters>
        <filters>
            <field>Status</field>
            <operator>NotEqualTo</operator>
            <value>
                <stringValue>Customer Approved</stringValue>
            </value>
        </filters>
        <filters>
            <field>LastModifiedDate</field>
            <operator>LessThan</operator>
            <value>
                <elementReference>fThreshold</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Status</field>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>ExpirationDate</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>RES_System_Status_Update__c</field>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <recordUpdates>
        <name>Reset_System_Flag</name>
        <label>Reset System Flag</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <faultConnector>
            <targetReference>Log_Reset_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Expired</stringValue>
            </value>
        </filters>
        <filters>
            <field>RES_System_Status_Update__c</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <inputAssignments>
            <field>RES_System_Status_Update__c</field>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </inputAssignments>
        <object>Quote</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Expire_Old_Non_Primary_Quotes</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-08-07</startDate>
            <startTime>01:00:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
