<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <apiVersion>67.0</apiVersion>
    <description>DIR-869 DOA-Routed Discount Approval. Auto-submits when a Quote in Negotiating has Discount changed ( &gt; 0 ). Sets Pending Approval, notifies the manager (bell + email), routes: Discount &lt;= 10% -&gt; Sales Manager only; &gt; 10% -&gt; Sales Manager then RES_Finance_Team queue. Branches on the queried ApprovalWorkItem status (orchestration can't gate on an approval step's approvalDecision output). Final approve -&gt; Approved; any reject -&gt; Rejected + notify initiator; Recall -&gt; Negotiating.</description>
    <environments>Default</environments>
    <formulas>
        <name>fApproverBody</name>
        <dataType>String</dataType>
        <expression>"Quote " &amp; {!$Record.Name} &amp; " (" &amp; {!$Record.QuoteNumber} &amp; ") needs your approval. Discount " &amp; TEXT({!$Record.Discount}) &amp; "% (Amount " &amp; TEXT(({!$Record.Subtotal} - {!$Record.GrandTotal})) &amp; "). Submitted by " &amp; {!$Record.CreatedBy.FirstName} &amp; " " &amp; {!$Record.CreatedBy.LastName} &amp; "."</expression>
    </formulas>
    <formulas>
        <name>fApproverSubject</name>
