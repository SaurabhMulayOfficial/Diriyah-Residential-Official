    <description>DIR-1612: Snapshots a Quote's Discount % and Discount Amount at the moment it enters Sales Manager approval, so the DOA orchestration can detect if either value drifts after the Sales Manager's decision (before Finance approval or final sign-off) and force a fresh approval cycle instead of acting on a stale decision.</description>
    <environments>Default</environments>
    <interviewLabel>RES Autolaunched Capture Quote Discount {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Autolaunched Capture Quote Discount</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Quote</name>
        <label>Get Quote</label>
        <locationX>176</locationX>
        <locationY>144</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Assign_Discount</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
