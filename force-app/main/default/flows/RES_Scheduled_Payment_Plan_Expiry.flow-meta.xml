    <description>Daily scheduled job. Launches RES_PaymentPlanExpiryBatch so Payment Plans past their Validity End Date are removed from the Units they are tagged to (one default Payment Plan is kept per Unit). A plan expiring on a date boundary involves no record save, so no trigger sees it. Scheduled flows are deployable metadata, unlike Apex System.schedule.</description>
    <environments>Default</environments>
    <interviewLabel>RES Scheduled Payment Plan Expiry {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Scheduled Payment Plan Expiry</label>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Run_Payment_Plan_Expiry_Batch</targetReference>
        </connector>
        <schedule>
            <frequency>Daily</frequency>
            <startDate>2026-10-17</startDate>
            <startTime>00:30:00.000Z</startTime>
        </schedule>
        <triggerType>Scheduled</triggerType>
    </start>
    <status>Active</status>
</Flow>
