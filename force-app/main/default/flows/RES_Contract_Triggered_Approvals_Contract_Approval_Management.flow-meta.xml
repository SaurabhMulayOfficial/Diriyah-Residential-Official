    <formulas>
        <name>RejectComments</name>
        <dataType>String</dataType>
        <expression>IF(
    NOT(ISBLANK({!Approval_Sent_to_Finance.Outputs.approvalComments})),
    {!Approval_Sent_to_Finance.Outputs.approvalComments},
    IF(
        NOT(ISBLANK({!Approval_Send_to_ED_Tresury.Outputs.approvalComments})),
        {!Approval_Send_to_ED_Tresury.Outputs.approvalComments},
        IF(
            NOT(ISBLANK({!Approval_Sent_to_CBDO.Outputs.approvalComments})),
            {!Approval_Sent_to_CBDO.Outputs.approvalComments},
            &quot;&quot;
        )
    )
)</expression>
    </formulas>
