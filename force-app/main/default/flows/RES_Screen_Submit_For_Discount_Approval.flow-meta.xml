<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <decisions>
        <name>Check_Access</name>
        <label>Check Access</label>
        <locationX>176</locationX>
        <locationY>48</locationY>
        <defaultConnector>
            <targetReference>Access_Denied_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Access</defaultConnectorLabel>
        <rules>
            <name>Has_Access</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Permission.RES_Can_Submit_Discount_Approval</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Quote_For_Manager_Check</targetReference>
            </connector>
            <label>Has Access</label>
        </rules>
    </decisions>
    <decisions>
        <name>Check_Manager_Present</name>
        <label>Check Manager Present</label>
        <locationX>176</locationX>
        <locationY>102</locationY>
        <defaultConnector>
            <targetReference>Comment_Screen</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Manager Present</defaultConnectorLabel>
        <rules>
            <name>Manager_Missing</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Quote_Owner.ManagerId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Manager_Missing_Screen</targetReference>
            </connector>
            <label>Manager Missing</label>
        </rules>
    </decisions>
    <description>DIR-869: "Submit for Discount Approval" quick action screen. Enforces access (RES_Can_Submit_Discount_Approval custom permission) internally, captures an optional justification comment from the RM/Specialist, then flags the Quote for the DOA orchestration to pick up. DIR-1612: Reset_Flag_First and Submit_Quote both route DML faults (e.g. ENTITY_IS_LOCKED when the quote already has a discount approval in progress) to Pending_Approval_Screen instead of surfacing the raw platform error to the user. DIR-1612: Get_Quote_For_Manager_Check/Check_Manager_Present block submission up front with Manager_Missing_Screen when the Quote Owner has no Manager set, instead of letting the DOA orchestration silently stall at Initiate_Approval with no feedback to anyone.</description>
    <environments>Default</environments>
    <interviewLabel>Submit for Discount Approval {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Submit for Discount Approval</label>
    <processType>Flow</processType>
