<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>67.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <description>DIR-869: Sets RES_Approval_Request_Remarks__c on the latest ApprovalWorkItem for a record and a given approval-condition (step) name. Used two ways: (1) pre-fill with Quote/discount context when the work item is created, so the approver sees it without opening the record; (2) overwrite with the approver's own decision comment once they decide (ApprovalWorkItem.Comments itself is a platform-locked standard field that can&apos;t be written outside the native approval screen, so this custom field carries the same information instead).</description>
    <environments>Default</environments>
    <interviewLabel>RES Set Approval Work Item Comments {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Autolaunched Set Approval Work Item Comments</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Latest_Work_Item</name>
        <label>Get Latest Work Item</label>
        <locationX>176</locationX>
        <locationY>168</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Has_Work_Item</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>RelatedRecordId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>recordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ApprovalConditionName</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>conditionName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>ApprovalWorkItem</object>
        <sortField>CreatedDate</sortField>
        <sortOrder>Desc</sortOrder>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <decisions>
        <name>Has_Work_Item</name>
        <label>Has Work Item</label>
        <locationX>176</locationX>
        <locationY>276</locationY>
        <defaultConnectorLabel>No Work Item Found</defaultConnectorLabel>
        <rules>
            <name>Work_Item_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_Latest_Work_Item.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Work_Item_Comments</targetReference>
            </connector>
            <label>Work Item Found</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Update_Work_Item_Comments</name>
        <label>Update Work Item Comments</label>
        <locationX>176</locationX>
        <locationY>384</locationY>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Latest_Work_Item.Id</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>RES_Approval_Request_Remarks__c</field>
            <value>
                <elementReference>comments</elementReference>
            </value>
        </inputAssignments>
        <object>ApprovalWorkItem</object>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Latest_Work_Item</targetReference>
        </connector>
    </start>
    <status>Draft</status>
    <variables>
        <name>comments</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>conditionName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>recordId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
