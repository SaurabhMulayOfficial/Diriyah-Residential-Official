            </value>
        </filters>
        <filters>
            <field>RES_Payment_Plan_Confirmed__c</field>
            <operator>IsChanged</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <filters>
            <field>RES_Payment_Plan_Confirmed__c</field>
            <operator>EqualTo</operator>
