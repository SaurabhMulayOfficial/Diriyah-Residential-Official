<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <name>Set_Merge_Fields</name>
        <label>Set Merge Fields</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>mergeFields</assignToReference>
            <operator>Add</operator>
            <value>
                <stringValue>Operations Team</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>mergeFields</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>Get_Contract.ContractNumber</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>mergeFields</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>recordURL</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Send_Notification_To_Operations_Group</targetReference>
        </connector>
    </assignments>
    <decisions>
        <name>Flow_On_Off_Check</name>
        <label>Flow On/Off Check</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Flow_On</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Setup.RES_Config_Switch__c.RES_Flows_Off__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Opportunity_Record_Type</targetReference>
            </connector>
            <label>Flow On</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Residential_Opportunity</name>
        <label>Is Residential Opportunity?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Opportunity_Record_Type.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.RES_Opportunity_Single_Buyer_RT</elementReference>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Opportunity_Record_Type.DeveloperName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>$Label.RES_Opportunity_Multi_Buyer_RT</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stage_Changed_To_SPA</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <name>Stage_Changed_To_SPA</name>
        <label>Stage Changed To SPA?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>SPA_Stage</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>IsChanged</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>SPA</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.StageName</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>$Record__Prior.StageName</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Primary_Quote</targetReference>
            </connector>
            <label>SPA Stage</label>
        </rules>
    </decisions>
    <environments>Default</environments>
    <formulas>
        <name>bellNotificationBody</name>
        <dataType>String</dataType>
        <expression>&quot;The opportunity for Contract - &quot; &amp; {!Get_Contract.ContractNumber} &amp; &quot; has reached the SPA stage. The &apos;Submit For Finance Approval&apos; button is now enabled on the contract.&quot;</expression>
    </formulas>
    <formulas>
        <name>recordURL</name>
        <dataType>String</dataType>
        <expression>LEFT(
    {!$Api.Partner_Server_URL_610},
    FIND(&quot;/services&quot;, {!$Api.Partner_Server_URL_610})
)
&amp;
&quot;/&quot;
&amp;
{!Get_Contract.Id}</expression>
    </formulas>
    <interviewLabel>RES Opportunity - After Insert - Update Closed Date after 30 Days {!$Flow.CurrentDateTime}</interviewLabel>
    <label>RES Opportunity - After Update - SPA Stage Send Notification To Operations</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Get_Contract</name>
        <label>Get Contract</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Set_Merge_Fields</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Get_Primary_Quote.ContractId</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Contract</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Opportunity_Record_Type</name>
        <label>Get Opportunity Record Type</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Is_Residential_Opportunity</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RecordTypeId</elementReference>
            </value>
        </filters>
        <filters>
            <field>SobjectType</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Opportunity</stringValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>RecordType</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Primary_Quote</name>
        <label>Get Primary Quote</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_Contract</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>OpportunityId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <filters>
            <field>IsSyncing</field>
            <operator>EqualTo</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Quote</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Flow_On_Off_Check</targetReference>
        </connector>
        <object>Opportunity</object>
        <recordTriggerType>Update</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <subflows>
        <name>Send_Notification_To_Operations_Group</name>
        <label>Send Notification To Operations Group</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <flowName>RES_Send_Notification_To_Operations_Group</flowName>
        <inputAssignments>
            <name>bellNotificationBody</name>
            <value>
                <elementReference>bellNotificationBody</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>bellNotificationTitle</name>
            <value>
                <stringValue>Submit For Finance Approval is now enabled</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>customNotificationName</name>
            <value>
                <stringValue>RES_Contract_Finance_Approval_Notification</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>emailTemplateName</name>
            <value>
                <stringValue>RES_Submit_For_Finance_Approval_Enabled</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>mergeFields</name>
            <value>
                <elementReference>mergeFields</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>publicGroupDeveloperName</name>
            <value>
                <stringValue>RES_Operations_Group</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>recordId</name>
            <value>
                <elementReference>Get_Contract.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <name>sendBellNotification</name>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </inputAssignments>
    </subflows>
    <variables>
        <name>mergeFields</name>
        <dataType>String</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
